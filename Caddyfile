conspect.su {
    root * /www/conspect
    encode zstd gzip

    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "no-referrer"

    # Vite asset filenames are content-hashed, so they can be cached forever.
    header /assets/* Cache-Control "public, max-age=31536000, immutable"

    # The shell is unhashed and each deploy swaps the release it is served from, so a cached
    # shell would point at hashed assets that no longer exist. `no-cache` still caches it, but
    # makes the browser revalidate first, so a deploy is picked up on the next visit.
    @shell not path /assets/*
    header @shell Cache-Control "no-cache"

    try_files {path} /index.html
    file_server
}
