{
	"name": "conspect",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "svelte-check && vite build",
		"dev": "vite",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"lint": "oxlint --fix",
		"lint:check": "oxlint",
		"prepare": "husky",
		"preview": "vite preview",
		"test": "vitest run",
		"types:check": "svelte-check --fail-on-warnings",
		"types:generate": "openapi-typescript ../conspect-api/openapi.json -o src/api/schema.d.ts"
	},
	"dependencies": {
		"@fontsource-variable/literata": "^5.3.0",
		"openapi-fetch": "^0.17.0",
		"svelte": "^5.57.1"
	},
	"devDependencies": {
		"@dragunovartem99/oxfmt-config": "^2.1.0",
		"@dragunovartem99/oxlint-config": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.2",
		"husky": "^9.1.7",
		"openapi-typescript": "^7.13.0",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
